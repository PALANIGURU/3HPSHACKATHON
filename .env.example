# Django Secrets
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Jira Cloud API Configuration (Optional)
# If set, real-life Jira issue updates & worklogs will be fetched directly via Jira REST API.
# If omitted or invalid, 3HPS gracefully falls back to normalized sample Jira events without crashing.
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_EMAIL=yourname@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=ALL
